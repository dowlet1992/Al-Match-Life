FLASK_ENV=development
APP_ENV=development
APP_HOST=127.0.0.1
# macOS commonly reserves port 5000 for AirPlay/AirTunes.
APP_PORT=5001
FLASK_SECRET_KEY=change-me
FLASK_SECRET_KEY_FILE=
# Optional in development; required for encrypted JSON storage in production.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Separate Base64-encoded 32-byte key for encrypted PostgreSQL backup exports.
# Generate locally with: openssl rand -base64 32
NOVIX_BACKUP_ENCRYPTION_KEY=
ADMIN_EMAILS=

STORAGE_BACKEND=json
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_ENABLED=true
DATABASE_POOL_MAX_SIZE=10

# Production host directory mounted at /app/uploads. Keep it outside Git and
# include it in the verified full-backup job.
NOVIX_MEDIA_DIR=/var/lib/novix/uploads

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TRANSLATION_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_KEEP_ALIVE=15m
ALLOW_REMOTE_AI_PROVIDER=false

# Local speech-to-text. Install optional dependencies from requirements-local-ai.txt.
SPEECH_PROVIDER=faster-whisper
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
REALTIME_SPEECH_PROVIDER=local
TTS_PROVIDER=browser

# Optional speech/realtime provider. The text AI Assistant does not use this key.
OPENAI_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Group audio/video conferences (self-hosted LiveKit SFU).
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
# Use at least 32 random characters outside local development.
LIVEKIT_API_SECRET=

LOGIN_2FA_ENABLED=false

# At least one push provider is required in production. Web Push is the
# smallest complete option for the web MVP; mount the private key as a file.
VAPID_PRIVATE_KEY_FILE=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:security@example.com
